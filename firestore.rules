rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /usuarios/{uid}/perfil/foto {
   allow get: if request.auth != null
    && request.auth.uid == uid
    && request.auth.token.email_verified == true;
   allow list: if false;
   allow create, update: if request.auth != null
    && request.auth.uid == uid
    && request.auth.token.email_verified == true
    && request.resource.data.keys().hasOnly(['imagem'])
    && request.resource.data.imagem is string
    && request.resource.data.imagem.size() < 200000
    && request.resource.data.imagem.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
   allow delete: if false;
  }
  match /{document=**} {allow read, write: if false;}
 }
}
