rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada pessoa acessa apenas sua propria foto, apos verificar o e-mail.
    match /usuarios/{uid}/perfil/{fotoId} {
      function donoVerificado() {
        return request.auth != null
          && request.auth.uid == uid
          && request.auth.token.email_verified == true;
      }

      // O aplicativo usa exclusivamente o documento "foto".
      allow get: if fotoId == "foto" && donoVerificado();
      allow list: if false;

      allow create, update: if fotoId == "foto"
        && donoVerificado()
        && request.resource.data.keys().hasOnly(["imagem"])
        && request.resource.data.keys().hasAll(["imagem"])
        && request.resource.data.imagem is string
        && request.resource.data.imagem.size() <= 200000
        && request.resource.data.imagem.matches(
          '^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$'
        );

      allow delete: if false;
    }

    // Todo o restante permanece bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
